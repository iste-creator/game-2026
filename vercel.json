{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/teamA/?$",
      "dest": "/teamA/index.html"
    },
    {
      "src": "/teamB/?$",
      "dest": "/teamB/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
